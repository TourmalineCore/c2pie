      "boundElements": [],
      "updated": 1777353774095,
      "link": null,
      "locked": false,
      "text": "В сериализованном виде:\nd2          ; тег 18 (COSE_Sign1)\n84          ; массив из 4 элементов\n  ...          ; protected, unprotected, payload, signature",
      "fontSize": 36,
      "fontFamily": 6,
