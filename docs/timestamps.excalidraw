      "isDeleted": false,
      "boundElements": [],
      "updated": 1777353543613,
      "link": null,
      "locked": false,
      "text": "COSE_Sign = [\n    protected,\n    unprotected,\n    payload,\n    signatures <- [COSE_Signature]\n]",
