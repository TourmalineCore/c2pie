      "boundElements": [],
      "updated": 1777352199961,
      "link": null,
      "locked": false,
      "text": "\"Signature\" <- COSE_Signature внутри COSE_Sign\n\"Signature1\" <- COSE_Sign1\n\"CounterSignature\" <- контр-подпись",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Signature\" <- COSE_Signature внутри COSE_Sign\n\"Signature1\" <- COSE_Sign1\n\"CounterSignature\" <- контр-подпись",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
