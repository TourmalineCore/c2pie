      "type": "text",
      "x": 4533.040649392619,
      "y": 3234.1583345021245,
      "width": 1115.953150624275,
      "height": 145.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
