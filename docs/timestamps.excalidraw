    },
    {
      "id": "DJ-W1l6SakaxZxtezkLRD",
      "type": "text",
      "x": 4533.5560651846345,
      "y": 2695.6271197041947,
      "width": 1154.5809130837724,
      "height": 97.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 745858854,
      "version": 337,
      "versionNonce": 1197116902,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777351847939,
      "link": null,
      "locked": false,
      "text": "Подписываемые данные. Может быть либо встроен (bstr), либо\nпередан отдельно - detached content (nil).",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Подписываемые данные. Может быть либо встроен (bstr), либо передан отдельно - detached content (nil).",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "4IwTGbLpZEU2nwX9bSUwf",
      "type": "text",
      "x": 4532.607938289749,
      "y": 2844.4411428296917,
      "width": 1149.54864373832,
      "height": 145.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 2130820838,
      "version": 200,
      "versionNonce": 1037820198,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777351847939,
      "link": null,
      "locked": false,
      "text": "В C2PA используется detached content mode: payload = nil, а сами\nданные (сериализованный CBOR Claim) существуют отдельно от\nструктуры подписи.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "В C2PA используется detached content mode: payload = nil, а сами данные (сериализованный CBOR Claim) существуют отдельно от структуры подписи.",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "CtChGvvUpkTeEcpaCdqQ0",
      "type": "text",
      "x": 4532.841121409836,
      "y": 3168.663856598467,
