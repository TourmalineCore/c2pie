    {
      "id": "kXae2Rm-pPb2MJGsX6EAf",
      "type": "text",
      "x": 6671.547844593014,
      "y": 1939.7849615772684,
      "width": 1175.543701171875,
      "height": 437.40000000000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1L",
      "roundness": null,
      "seed": 661654694,
      "version": 124,
      "versionNonce": 86015526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777353867138,
      "link": null,
      "locked": false,
      "text": "COSE_Messages = COSE_Untagged_Message / COSE_Tagged_Message\n\nCOSE_Untagged_Message = COSE_Sign / COSE_Sign1 /\n    COSE_Encrypt / COSE_Encrypt0 /\n    COSE_Mac / COSE_Mac0\n\nCOSE_Tagged_Message = COSE_Sign_Tagged / COSE_Sign1_Tagged /\n    COSE_Encrypt_Tagged / COSE_Encrypt0_Tagged /\n    COSE_Mac_Tagged / COSE_Mac0_Tagged",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COSE_Messages = COSE_Untagged_Message / COSE_Tagged_Message\n\nCOSE_Untagged_Message = COSE_Sign / COSE_Sign1 /\n    COSE_Encrypt / COSE_Encrypt0 /\n    COSE_Mac / COSE_Mac0\n\nCOSE_Tagged_Message = COSE_Sign_Tagged / COSE_Sign1_Tagged /\n    COSE_Encrypt_Tagged / COSE_Encrypt0_Tagged /\n    COSE_Mac_Tagged / COSE_Mac0_Tagged",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
