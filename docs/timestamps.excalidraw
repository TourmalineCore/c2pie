      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Разница между COSE_Sign и COSE_Sign1:",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "AkzH2nlFUGYQ86pvl_Khx",
      "type": "text",
      "x": 6676.801524773727,
      "y": -364.67759254031705,
