    },
    {
      "id": "CVX8EkNBqlEwcG9raMWnj",
      "type": "text",
      "x": 4513.218087924729,
      "y": -631.3839515204215,
      "width": 1493.2295405822715,
      "height": 145.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 177246714,
      "version": 225,
      "versionNonce": 568950630,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777350833317,
      "link": null,
      "locked": false,
      "text": "COSE (CBOR Object Signing and Encryption) - это протокол для обеспечения\nкриптографических сервисов (подписи, шифрование, MAC) поверх формата CBOR.\nОн является CBOR-аналогом JOSE (JSON Object Signing and Encryption).",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "COSE (CBOR Object Signing and Encryption) - это протокол для обеспечения криптографических сервисов (подписи, шифрование, MAC) поверх формата CBOR. Он является CBOR-аналогом JOSE (JSON Object Signing and Encryption).",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "ltecj6dklfZ_5PGFu7yYi",
      "type": "text",
      "x": 6660.982897553504,
      "y": -634.5444055251197,
      "width": 1197.25146484375,
      "height": 97.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 1874751610,
      "version": 235,
      "versionNonce": 195432058,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777353540730,
      "link": null,
      "locked": false,
      "text": "JOSE (JSON Object Signing and Encryption)\nhttps://www.redhat.com/en/blog/jose-json-object-signing-and-encryption",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JOSE (JSON Object Signing and Encryption)\nhttps://www.redhat.com/en/blog/jose-json-object-signing-and-encryption",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "S5W2dBINZOC3V3phwsAIi",
      "type": "text",
      "x": 4524.420048348615,
      "y": -422.5804791141079,
      "width": 1507.3194580078125,
      "height": 340.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 678754406,
      "version": 127,
      "versionNonce": 126916710,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777350445975,
      "link": null,
      "locked": false,
      "text": "CBOR Tag        cose-type        Data Item        Semantics\n98        cose-sign        COSE_Sign        COSE Signed Data Object\n18        cose-sign1        COSE_Sign1        COSE Single Signer Data Object\n96        cose-encrypt        COSE_Encrypt        COSE Encrypted Data Object\n16        cose-encrypt0        COSE_Encrypt0        COSE Single Recipient Encrypted Data Object\n97        cose-mac        COSE_Mac        COSE MACed Data Object\n17        cose-mac0        COSE_Mac0        COSE Mac w/o Recipients Object",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CBOR Tag        cose-type        Data Item        Semantics\n98        cose-sign        COSE_Sign        COSE Signed Data Object\n18        cose-sign1        COSE_Sign1        COSE Single Signer Data Object\n96        cose-encrypt        COSE_Encrypt        COSE Encrypted Data Object\n16        cose-encrypt0        COSE_Encrypt0        COSE Single Recipient Encrypted Data Object\n97        cose-mac        COSE_Mac        COSE MACed Data Object\n17        cose-mac0        COSE_Mac0        COSE Mac w/o Recipients Object",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "gC6bwS0xJjjcMF98jfd1X",
      "type": "text",
      "x": 4523.335021191808,
      "y": 165.93699782689623,
      "width": 259.59588623046875,
      "height": 291.6,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
