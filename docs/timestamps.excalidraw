      "boundElements": [],
      "updated": 1777354713859,
      "link": null,
      "locked": false,
      "text": "DER (Distinguished Encoding Rules) — это один из способов бинарного кодирования\nданных, описанных в нотации ASN.1.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DER (Distinguished Encoding Rules) — это один из способов бинарного кодирования данных, описанных в нотации ASN.1.",
      "autoResize": false,
      "lineHeight": 1.35
    },
