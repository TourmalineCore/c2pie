      "seed": 769278091,
      "version": 1262,
      "versionNonce": 493534741,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "06l4ugHeNV5JpYADf6WqV",
          "type": "arrow"
        }
      ],
      "updated": 1785747546031,
      "link": null,
      "locked": false,
      "text": "Since each feature branch is merged into the develop\nbranch as a squash commit, the message of that\nsquash commit (the PR title, which is edited during\nthe merge) plays a key role in the version bump. \n\nIntermediate commits within the feature branch are\nnot saved as separate entries in the develop history\nand do not affect the version bump.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Since each feature branch is merged into the develop branch as a squash commit, the message of that squash commit (the PR title, which is edited during the merge) plays a key role in the version bump. \n\nIntermediate commits within the feature branch are not saved as separate entries in the develop history and do not affect the version bump.",
      "autoResize": false,
      "lineHeight": 1.35
    },
