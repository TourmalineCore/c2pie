      "updated": 1785383830303,
      "link": null,
      "locked": false,
      "text": "The hotfix branch must be merged into both the master (Merge\ncommit mode) and develop (Squash commit mode) branches. This\ndouble merge is necessary to keep both branches up to date and to\navoid conflicts and early changes being pushed between the\ndevelop and master branches.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The hotfix branch must be merged into both the master (Merge commit mode) and develop (Squash commit mode) branches. This double merge is necessary to keep both branches up to date and to avoid conflicts and early changes being pushed between the develop and master branches.",
      "autoResize": false,
      "lineHeight": 1.35
    },
