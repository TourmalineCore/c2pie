    {
      "id": "uJCdS5PZIUZqm4Rt7ywru",
      "type": "text",
      "x": 1851.94661331495,
      "y": -7029.166126842392,
      "width": 561.5189252289381,
      "height": 86.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "zvrWguhOpS0R3O9Xk2O17"
      ],
      "frameId": null,
      "index": "c0Jd",
      "roundness": null,
      "seed": 1887445226,
      "version": 4374,
      "versionNonce": 645974618,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785225803954,
      "link": null,
      "locked": false,
      "text": "PyPI has strict release naming conventions based on PEP 440, which allow\nonly the prefixes `bN`, `aN`, `rcN`, `.devN`, and `postN` in a version number,\nwhere `N` is any sequence of numbers. Therefore, `rcN` was chosen for hotfix\nreleases, as it makes the most logical sense.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PyPI has strict release naming conventions based on PEP 440, which allow only the prefixes `bN`, `aN`, `rcN`, `.devN`, and `postN` in a version number, where `N` is any sequence of numbers. Therefore, `rcN` was chosen for hotfix releases, as it makes the most logical sense.",
      "autoResize": false,
      "lineHeight": 1.35
    },
