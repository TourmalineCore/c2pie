    {
      "id": "Od4dkBYCbGox3EdyZQ0Xy",
      "type": "text",
      "x": 2290.6865196322105,
      "y": -5962.83053659419,
      "width": 497.14477226121585,
      "height": 324,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0GQ",
