    {
      "id": "uJCdS5PZIUZqm4Rt7ywru",
      "type": "text",
      "x": 1851.94661331495,
      "y": -7029.166126842392,
      "width": 561.5189252289381,
      "height": 86.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
