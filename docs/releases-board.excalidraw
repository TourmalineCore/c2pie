      "isDeleted": false,
      "boundElements": [],
      "updated": 1784873635653,
      "link": null,
      "locked": false,
      "text": "When deleting a release branch, it is necessary to also delete the\nreleases and tags created on it; otherwise, it will not be possible to\ngenerate a new tag on a new release branch.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When deleting a release branch, it is necessary to also delete the releases and tags created on it; otherwise, it will not be possible to generate a new tag on a new release branch.",
      "autoResize": false,
      "lineHeight": 1.35
    },
