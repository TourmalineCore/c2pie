    {
      "id": "YKZA6aUJk8WGYU_yFEyyb",
      "type": "text",
      "x": -2310.759485630543,
      "y": -4852.801038236342,
      "width": 561.5189252289381,
      "height": 86.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
