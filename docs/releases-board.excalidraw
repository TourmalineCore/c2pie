      "updated": 1785752872131,
      "link": null,
      "locked": false,
      "text": "If a minor bump has already occurred in the channel, a subsequent\npatch commit (fix, docs and refactor) does not lower or change the\nbase version - only N is incremented.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If a minor bump has already occurred in the channel, a subsequent patch commit (fix, docs and refactor) does not lower or change the base version - only N is incremented.",
      "autoResize": false,
      "lineHeight": 1.35
    },
