      "boundElements": null,
      "updated": 1785753529631,
      "link": null,
      "locked": false,
      "text": "If necessary, to apply hotfix fixes to the `develop` branch, you can\nmove the relevant commits to the `feature` branch using `cherry-\npick`, and then merge the fixes into the `develop` branch.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If necessary, to apply hotfix fixes to the `develop` branch, you can move the relevant commits to the `feature` branch using `cherry-pick`, and then merge the fixes into the `develop` branch.",
      "autoResize": false,
      "lineHeight": 1.35
    },
