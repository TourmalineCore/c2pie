      "updated": 1785752646853,
      "link": null,
      "locked": false,
      "text": "The PR must be closed in Squash and merge mode.\n\nThis groups all commits in the branch into a single\ncommit with a Conventional Commits-formatted\nmessage (taken from the PR title), so that\nCHANGELOG.md contains a single correct entry for\nthe PR.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The PR must be closed in Squash and merge mode.\n\nThis groups all commits in the branch into a single commit with a Conventional Commits-formatted message (taken from the PR title), so that CHANGELOG.md contains a single correct entry for the PR.",
      "autoResize": false,
      "lineHeight": 1.35
    },
