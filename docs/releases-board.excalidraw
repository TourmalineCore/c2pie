    {
      "id": "Od4dkBYCbGox3EdyZQ0Xy",
      "type": "text",
      "x": 2290.6865196322105,
      "y": -5962.83053659419,
      "width": 497.14477226121585,
      "height": 324,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0GQ",
      "roundness": null,
      "seed": 1212115958,
      "version": 1094,
      "versionNonce": 503066650,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785225803951,
      "link": null,
      "locked": false,
      "text": "Добавить отдельную develop ветку:\n\nПлюсы:\n+ Сохранится возможность группировать\nизменения в рамках единого релиза, что\nпредотвратит ускоренный рост stable версии\n+ Дублирующаяся логика относительно master\nветки, не нужно запоминать новый флоу\n\nМинусы:\n- Усложнение работы за счет увеличение\nколичества веток",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Добавить отдельную develop ветку:\n\nПлюсы:\n+ Сохранится возможность группировать изменения в рамках единого релиза, что предотвратит ускоренный рост stable версии\n+ Дублирующаяся логика относительно master ветки, не нужно запоминать новый флоу\n\nМинусы:\n- Усложнение работы за счет увеличение количества веток",
      "autoResize": false,
      "lineHeight": 1.35
    },
    {
      "id": "Eh2Zqt51C9pSB1imn42o3",
      "type": "text",
      "x": 3145.1616686411126,
