      "updated": 1785748086825,
      "link": null,
      "locked": false,
      "text": "If necessary, commits from the release branch can be moved to the\nfeature branch using the cherry-pick. It need before you remove the\ncorresponding release branch.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If necessary, commits from the release branch can be moved to the feature branch using the cherry-pick. It need before you remove the corresponding release branch.",
      "autoResize": false,
      "lineHeight": 1.35
    },
