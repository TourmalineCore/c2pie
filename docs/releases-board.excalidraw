      "updated": 1784867386537,
      "link": null,
      "locked": false,
      "text": "The feature-version of the published package contains the latest\nreleased version in the develop branch from which the “feature”\nbranch was created, in addition to the build metadata.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The feature-version of the published package contains the latest released version in the develop branch from which the “feature” branch was created, in addition to the build metadata.",
      "autoResize": false,
      "lineHeight": 1.35
