      "isDeleted": false,
      "boundElements": [],
      "updated": 1785225803954,
      "link": null,
      "locked": false,
      "text": "The version within the hotfix branch does not affect the version\nthat will be calculated in the master or maintenance branches.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The version within the hotfix branch does not affect the version that will be calculated in the master or maintenance branches.",
      "autoResize": false,
      "lineHeight": 1.35
    },
