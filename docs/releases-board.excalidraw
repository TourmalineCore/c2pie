      "isDeleted": false,
      "boundElements": [],
      "updated": 1785225803951,
      "link": null,
      "locked": false,
      "text": "Уточнить, что там по N.x.x N.x\n веткам",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Уточнить, что там по N.x.x N.x\n веткам",
