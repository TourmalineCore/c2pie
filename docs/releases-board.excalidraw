      "text": "A maintenance branch is created only when support for a previous\nmajor version is needed. It may be created later, if necessary.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A maintenance branch is created only when support for a previous major version is needed. It may be created later, if necessary.",
