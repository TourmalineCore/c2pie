      "boundElements": [],
      "updated": 1785752862973,
      "link": null,
      "locked": false,
      "text": "The release branches are short-lived, so new commits are not\nmerged into `develop` as long as there is an active `release/*`\nbranch.\n\nThis restriction helps avoid potential conflicts when updating\n`develop` after a new stable release is released.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The release branches are short-lived, so new commits are not merged into `develop` as long as there is an active `release/*` branch.\n\nThis restriction helps avoid potential conflicts when updating `develop` after a new stable release is released.",
      "autoResize": false,
      "lineHeight": 1.35
    },
