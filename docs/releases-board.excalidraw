      "isDeleted": false,
      "boundElements": [],
      "updated": 1785753092000,
      "link": null,
      "locked": false,
      "text": "A hotfix is necessary when a bug fix needs\nto be applied to the master branch, while\npreventing changes from the develop branch\nfrom being merged earlier than planned.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A hotfix is necessary when a bug fix needs to be applied to the master branch, while preventing changes from the develop branch from being merged earlier than planned.",
      "autoResize": false,
      "lineHeight": 1.35
    },
