      "updated": 1785747980261,
      "link": null,
      "locked": false,
      "text": "Only commits with the “fix” type are allowed in the release branch.\n\nEach such commit increments the pre-release number (N),\nwithout changing the base version (x.y.z).",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only commits with the “fix” type are allowed in the release branch.\n\nEach such commit increments the pre-release number (N),\nwithout changing the base version (x.y.z).",
      "autoResize": false,
      "lineHeight": 1.35
    },
