      "updated": 1785130697497,
      "link": null,
      "locked": false,
      "text": "In cases where changes have been made to the same files in\nboth the current and target branches, before merging them, the\ntarget branch must be merged into the current branch.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In cases where changes have been made to the same files in both the current and target branches, before merging them, the target branch must be merged into the current branch.",
      "autoResize": false,
      "lineHeight": 1.35
    },
