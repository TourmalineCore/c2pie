    {
      "id": "Ok1GPAYWjPqq8JufkGRVU",
      "type": "text",
      "x": -3197.156984907526,
      "y": -1097.0312786892207,
      "width": 388.63398234757517,
      "height": 172.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
