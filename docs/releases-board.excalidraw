      ],
      "updated": 1785747508555,
      "link": null,
      "locked": false,
      "text": "PRs to the master branch must be closed with a\nMerge commit to keep the history of commits from\nthe develop and release branches. This allows the\nrelease-notes-generator to generate a complete\nCHANGELOG.md for the stable version, including all\ncommitted changes (feat!, feat, fix, docs and refactor).",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PRs to the master branch must be closed with a Merge commit to keep the history of commits from the develop and release branches. This allows the release-notes-generator to generate a complete CHANGELOG.md for the stable version, including all committed changes (feat!, feat, fix, docs and refactor).",
      "autoResize": false,
      "lineHeight": 1.35
    },
